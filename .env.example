# Скопіюйте в .env.local і заповніть.
# Токен — від @BotFather, chat id — id групи кафе (група, куди додано бота).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Посилання на CSV-експорт опублікованої Google Таблиці з меню.
# Google Таблиця → Файл → Поділитися → Опублікувати в інтернеті → аркуш з меню → CSV → скопіювати посилання.
# Без цієї змінної сайт показує вбудоване меню з src/data/menu.ts.
MENU_SHEET_CSV_URL=

# LiqPay (ФОП на PrivatBank) — публічний і приватний ключ з кабінету liqpay.ua.
# Ключі sandbox_* — для тестів; без них кнопка "Оплата онлайн" вимкнена.
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

# Публічна адреса сайту (без / в кінці) — потрібна LiqPay для редіректу й вебхука.
SITE_URL=
